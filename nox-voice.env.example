# Copy this file to nox-voice.env beside nox_voice.py.
# nox_voice.py will try to discover the model if this is left unset.
# NOX_VOSK_MODEL=/home/david/robot-hat/examples/vosk-model-small-en-us-0.15

NOX_AUDIO_DEVICE=plughw:2,0
NOX_VOICE_GAIN=1.0
NOX_BRIDGE_URL=http://127.0.0.1:8888
NOX_DAEMON_HOST=127.0.0.1
NOX_DAEMON_PORT=9999
NOX_VOICE_DEBOUNCE=1.5

# Bare "stop" is accepted without "Nox" because a false positive only halts
# locomotion. All other commands require the wake word.
NOX_STOP_WITHOUT_WAKE=1
