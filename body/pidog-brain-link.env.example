# Copy to /etc/pidog-brain-link.env and keep it root-owned (mode 600).
# Use the desktop's Tailscale MagicDNS machine name, not its home-LAN address.
PIDOG_BRAIN_HOST=pidog-brain
PIDOG_BRAIN_USER=d_s_h

# Dedicated key generated on the Pi by install-tailscale-autostart.sh.
PIDOG_BRAIN_IDENTITY=/home/david/.ssh/pidog_brain_ed25519

# These reverse forwards listen only on the desktop's loopback interface.
PIDOG_REMOTE_BRIDGE_PORT=18888
PIDOG_REMOTE_CAMERA_PORT=19000

# Pi-local services. Do not change these to 0.0.0.0.
PIDOG_LOCAL_BRIDGE_HOST=127.0.0.1
PIDOG_LOCAL_BRIDGE_PORT=8888
PIDOG_LOCAL_CAMERA_HOST=127.0.0.1
PIDOG_LOCAL_CAMERA_PORT=9000
