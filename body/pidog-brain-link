#!/usr/bin/env bash
set -euo pipefail

CONFIG=/etc/pidog-brain-link.env

log() {
    printf '[pidog-brain-link] %s\n' "$*"
}

if [[ ! -r "$CONFIG" ]]; then
    log "$CONFIG is missing; brain link is not configured"
    exit 2
fi

# The configuration is installed root-owned and mode 640 so the david service account can read it.
# shellcheck source=/dev/null
source "$CONFIG"

: "${PIDOG_BRAIN_HOST:?PIDOG_BRAIN_HOST is required}"
: "${PIDOG_BRAIN_USER:?PIDOG_BRAIN_USER is required}"

PIDOG_BRAIN_IDENTITY=${PIDOG_BRAIN_IDENTITY:-/home/david/.ssh/pidog_brain_ed25519}
PIDOG_REMOTE_BRIDGE_PORT=${PIDOG_REMOTE_BRIDGE_PORT:-18888}
PIDOG_REMOTE_CAMERA_PORT=${PIDOG_REMOTE_CAMERA_PORT:-19000}
PIDOG_LOCAL_BRIDGE_HOST=${PIDOG_LOCAL_BRIDGE_HOST:-127.0.0.1}
PIDOG_LOCAL_BRIDGE_PORT=${PIDOG_LOCAL_BRIDGE_PORT:-8888}
PIDOG_LOCAL_CAMERA_HOST=${PIDOG_LOCAL_CAMERA_HOST:-127.0.0.1}
PIDOG_LOCAL_CAMERA_PORT=${PIDOG_LOCAL_CAMERA_PORT:-9000}

for value in     "$PIDOG_REMOTE_BRIDGE_PORT" "$PIDOG_REMOTE_CAMERA_PORT"     "$PIDOG_LOCAL_BRIDGE_PORT" "$PIDOG_LOCAL_CAMERA_PORT"; do
    [[ "$value" =~ ^[0-9]+$ ]] && (( value >= 1 && value <= 65535 )) || {
        log "invalid TCP port: $value"
        exit 2
    }
done

if [[ ! -r "$PIDOG_BRAIN_IDENTITY" ]]; then
    log "SSH identity not found: $PIDOG_BRAIN_IDENTITY"
    exit 2
fi

log "waiting for Tailscale"
until tailscale status --json 2>/dev/null |
    python3 -c 'import json,sys; raise SystemExit(0 if json.load(sys.stdin).get("BackendState") == "Running" else 1)'     2>/dev/null; do
    sleep 5
done

log "Tailscale is ready; connecting to ${PIDOG_BRAIN_USER}@${PIDOG_BRAIN_HOST}"
log "desktop endpoints will be 127.0.0.1:${PIDOG_REMOTE_BRIDGE_PORT} and 127.0.0.1:${PIDOG_REMOTE_CAMERA_PORT}"

exec /usr/bin/ssh     -N -T     -o BatchMode=yes     -o ConnectTimeout=10     -o ConnectionAttempts=1     -o ServerAliveInterval=15     -o ServerAliveCountMax=3     -o ExitOnForwardFailure=yes     -o StrictHostKeyChecking=accept-new     -o UserKnownHostsFile=/home/david/.ssh/pidog_brain_known_hosts     -o IdentitiesOnly=yes     -i "$PIDOG_BRAIN_IDENTITY"     -R "127.0.0.1:${PIDOG_REMOTE_BRIDGE_PORT}:${PIDOG_LOCAL_BRIDGE_HOST}:${PIDOG_LOCAL_BRIDGE_PORT}"     -R "127.0.0.1:${PIDOG_REMOTE_CAMERA_PORT}:${PIDOG_LOCAL_CAMERA_HOST}:${PIDOG_LOCAL_CAMERA_PORT}"     "${PIDOG_BRAIN_USER}@${PIDOG_BRAIN_HOST}"
